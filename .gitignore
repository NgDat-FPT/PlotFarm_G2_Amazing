# ─── Environment ─────────────────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Frontend (scaffolded by create-next-app on first clone) ──────────────────
# Only the Dockerfile is committed — teammates run create-next-app themselves
frontend/
!frontend/Dockerfile

# ─── Next.js build output ─────────────────────────────────────────────────────
.next/
out/

# ─── Backend build ────────────────────────────────────────────────────────────
backend/dist/
backend/build/

# ─── Package locks ────────────────────────────────────────────────────────────
# Keeping package.json but ignoring lock files to avoid OS-specific conflicts
package-lock.json
yarn.lock
pnpm-lock.yaml

# ─── Prisma ───────────────────────────────────────────────────────────────────
# Keep migrations and schema, ignore generated client
backend/node_modules/.prisma/

# ─── Docker ───────────────────────────────────────────────────────────────────
# Keep docker-compose.yml, ignore override files with local secrets
docker-compose.override.yml

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Editor ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── Testing ──────────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Misc ─────────────────────────────────────────────────────────────────────
.cache/
.turbo/
